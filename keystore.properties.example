# Copy this file to `keystore.properties` (it is ignored by git) and fill it in to sign the release build.
# The same values can be given as the environment variables ANIMANGA_KEYSTORE_FILE,
# ANIMANGA_KEYSTORE_PASSWORD, ANIMANGA_KEY_ALIAS and ANIMANGA_KEY_PASSWORD, which is what CI uses.
# storeFile is relative to the root of the project.
storeFile=keystore/upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
